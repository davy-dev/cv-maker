# NextAuth v5 (required) — generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Anthropic (required for job analysis and CV generation)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OAuth GitHub (optional) — https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# OAuth Google (optional) — https://console.cloud.google.com/apis/credentials
# Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage (optional) — defaults: ./data/cv-maker.db and ./data/uploads
# DATABASE_PATH=
# UPLOAD_DIR=
